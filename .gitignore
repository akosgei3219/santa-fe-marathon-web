# ── Dependencies ────────────────────────────────────────────────────────────
landing-src/node_modules/
node_modules/

# ── Secrets and machine-local config ────────────────────────────────────────
# settings.local.json carries per-machine permission rules and matched a scan for
# credential-shaped strings. Real credentials live in C:/Users/info/mcp-server/.env,
# which is OUTSIDE this tree -- keep it that way.
.claude/settings.local.json*
# NOTE the trailing * -- settings.local.json.bak-20260818 also contains
# credential-shaped strings and would otherwise have been committed.
.env
.env.*
*.pem
*.key

# ── WordPress content dumps (23 MB, and they contain auth headers) ──────────
# Restore points for live pages: page JSON with content.raw, trash snapshots, and
# Basic-auth headers captured in a few of them. Never commit these.
backups/

# ── Nested git repository ───────────────────────────────────────────────────
# deploy/ is its OWN repo (branch main, commit 3c2259d). Tracking it from the
# parent would create a gitlink/submodule tangle. Commit inside deploy/ instead.
deploy/

# ── Build output, regenerated by build.js / build_v5.js on every run ────────
landing-src/dist-bundle.js
landing-src/dist-custom.css
landing-src/dist-tailwind.css
landing-src/custom.css
landing-src/tw-input.css
landing-src/tailwind.config.js
landing-src/src/app.jsx
landing-src/shim/
landing-src/proposals/*/work/
landing-src/proposals/*/dist-*

# The built artifact IS tracked on purpose: recreate-wp-page.js deploys it, and the
# repo-root and landing-src copies must stay byte-identical. Do not ignore it.
# !run-santa-fe-2026.prod.src.html

# ── Generated previews, captures and screenshots ────────────────────────────
landing-src/proposals/*/preview.html
landing-src/proposals/*/served-homepage.html
landing-src/proposals/*/*.png
*-preview.html

# ── Large binary originals ──────────────────────────────────────────────────
# 68 MB of camera originals. images/web/ (5.9 MB) IS tracked -- the static deploy
# and the homepage reference it.
images/originals/
# Loose camera files dropped straight into images/ and the repo root (2-3.5 MB each,
# ~33 MB together). images/web/ and images/<subdirs>/ stay tracked.
images/*.jpg
images/*.jpeg
images/*.JPG
images/*.heic
/*.heic
/*.HEIC
/*.jpg
/*.JPG

# 2.4 MB one-off full render from 2026-09-09. Not in the pipeline -- build.js uses
# run-santa-fe-2026.src.html and recreate-wp-page.js deploys *.prod.src.html.
run-santa-fe-2026.html

